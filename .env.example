# --- connection ---
ES_MCP_HOSTS=http://localhost:9200
# ES_MCP_API_KEY=base64_id_colon_api_key
# ES_MCP_USERNAME=elastic
# ES_MCP_PASSWORD=changeme
# ES_MCP_CA_CERTS=/etc/ssl/certs/es-ca.pem
ES_MCP_VERIFY_CERTS=true
ES_MCP_REQUEST_TIMEOUT=30
ES_MCP_MAX_RETRIES=3

# --- safety ---
ES_MCP_READ_ONLY=true
ES_MCP_ALLOW_DESTRUCTIVE=false
ES_MCP_INDEX_ALLOW=*
ES_MCP_INDEX_DENY=.*,security-*

# --- query limits ---
ES_MCP_DEFAULT_SIZE=10
ES_MCP_MAX_RESULT_SIZE=200
ES_MCP_MAX_AGG_BUCKETS=1000
ES_MCP_SEARCH_TIMEOUT=30s
ES_MCP_MAX_RESPONSE_CHARS=60000

# --- observability ---
ES_MCP_LOG_LEVEL=INFO
# ES_MCP_AUDIT_LOG_PATH=/var/log/es-mcp/audit.jsonl
